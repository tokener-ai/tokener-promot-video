{
  "name": "tokener-promot-video",
  "version": "1.0.0",
  "description": "Tokener promotional videos",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.522",
    "@remotion/fonts": "4.0.522",
    "@remotion/media": "4.0.522",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.522"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.522",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "typescript": "5.7.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render src/index.ts TokenerFilm out/tokener-ifcon-preview.mp4",
    "render:subtitled": "remotion render src/index.ts TokenerFilmSubtitled out/tokener-ifcon-4k-subtitled.mp4",
    "render:audio": "mkdir -p out && cp public/audio/tokener-ja.wav out/tokener-ja.wav",
    "render:cover": "remotion still src/index.ts TokenerCover out/tokener-cover.png"
  },
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "pnpm@11.21.0"
}
